<Project Sdk="Microsoft.NET.Sdk">

  <!-- Moteur de calcul métallerie, indépendant de SolidWorks (testable sans CAO). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>MetalForge.Core</RootNamespace>
    <AssemblyName>MetalForge.Core</AssemblyName>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Moteur de configuration atomique : le même fichier JavaScript que le configurateur web, exécuté par Jint. -->
  <ItemGroup>
    <PackageReference Include="Jint" Version="3.1.3" />
    <EmbeddedResource Include="..\..\web\configurateur\engine.js" LogicalName="MetalForge.Core.engine.js" Link="Atomic\engine.js" />
  </ItemGroup>

</Project>
