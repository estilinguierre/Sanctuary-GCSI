<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Complément SolidWorks (COM, .NET Framework 4.8, x64) : ISwAddin, commandes, volet WPF (MVVM).
    Enregistrement : Install\Enregistrer.bat (RegAsm /codebase, en administrateur).
    Les vues WPF sont écrites en C# (sans XAML) : elles compilent aussi hors Windows.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>MetalForge.AddIn</RootNamespace>
    <AssemblyName>MetalForge.AddIn</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
      <Platforms>x64</Platforms>
  </PropertyGroup>
  <Import Project="..\..\build\SolidWorks.props" />
  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MetalForge.Core\MetalForge.Core.csproj" />
    <ProjectReference Include="..\MetalForge.Library\MetalForge.Library.csproj" />
    <ProjectReference Include="..\MetalForge.Export\MetalForge.Export.csproj" />
    <ProjectReference Include="..\MetalForge.SwAdapter\MetalForge.SwAdapter.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Install\*.bat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
